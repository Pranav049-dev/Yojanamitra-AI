# ==================================================
# YOJANAMITRA AI — ENVIRONMENT CONFIGURATION
# ==================================================

# Application
PROJECT_NAME="YojanaMitra AI"
VERSION="1.0.0"

# Backend Security
SECRET_KEY="replace-with-a-secure-random-token-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Default: Local SQLite database
DATABASE_URL="sqlite:///./yojanamitra.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://yojanamitra:yojanamitra_secure_password_2026@localhost:5432/yojanamitra_db"

# AI Provider Configuration
# Options: "local_rag" (zero API key required, grounded search), "gemini", "openai"
AI_PROVIDER="local_rag"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL="gemini-1.5-flash"

# Frontend Configuration
NEXT_PUBLIC_API_URL="https://karen-refurbished-null-signature.trycloudflare.com/api"
